# ============================================================================
# AFROLASH CLIENT - VARIABLES DE ENTORNO (REACT 19 SPA)
# ============================================================================
# Copia este archivo como '.env' en la carpeta client/ para entornos locales
# o configúralas en el panel de control de Vercel / Netlify para producción.
# ============================================================================

# URL base del servicio backend API REST de Afrolash (Node.js / Express 5).
# - En desarrollo local: puedes dejarla vacía o comentada; el cliente asume
#   automáticamente 'http://localhost:5000' como valor de respaldo (fallback).
# - En producción: define la URL pública de la API desplegada (ej. Render),
#   sin barra diagonal al final (ej. https://afrolash-api.onrender.com).
REACT_APP_API_URL=http://localhost:5000

# Clave pública de Stripe (Publishable Key) para inicializar Stripe Elements
# en la pasarela de pagos del carrito de compras.
# Debe comenzar con 'pk_test_' (modo pruebas) o 'pk_live_' (modo producción).
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_tu_clave_publica_de_stripe_aqui
