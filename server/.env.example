# =====================================================================
# Afrolash API — Plantilla de Variables de Entorno (.env.example)
# NOTA: Duplicar este archivo como .env y asignar las credenciales reales.
# =====================================================================

# Configuración del Servidor Express
PORT=5000
NODE_ENV=development
# Proxy inverso (Render / balanceadores de carga). Usar 1 o true en producción cloud, false en desarrollo local.
TRUST_PROXY=false

# Credenciales de la Base de Datos MySQL (afrolash_db)
DB_HOST=localhost
DB_USER=escribe_tu_usuario_aqui
DB_PASSWORD=escribe_tu_contraseña_aqui
DB_NAME=afrolash_db
DB_PORT=3306
# Conexión SSL/TLS para MySQL en la nube (Aiven, TiDB). Usar true en producción cloud, false en desarrollo local.
DB_SSL=false
# Verificación estricta de certificado SSL (false para admitir certificados gestionados en plataformas gratuitas)
DB_SSL_REJECT_UNAUTHORIZED=false

# Secreto criptográfico para firma y verificación de tokens JWT (HS256)
JWT_SECRET=escribe_aqui_una_clave_secreta_robusta_para_el_JWT

# Clave secreta de la pasarela de pagos Stripe
STRIPE_SECRET_KEY=sk_test_escribe_aqui_tu_clave_secreta_de_stripe

# Credenciales de servicio SMTP para envío de correos (Gmail / Nodemailer)
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_clave_de_aplicacion_gmail

# Orígenes autorizados por la política CORS (separados por coma para múltiples orígenes)
FRONTEND_URL=http://localhost:3000
